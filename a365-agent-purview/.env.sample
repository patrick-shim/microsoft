# ═══════════════════════════════════════════════════════════════════════════════
#  a365-agent-purview — environment template
#  Copy this file to `.env` and fill it in.  `.env` is gitignored — NEVER commit it.
#
#  This is the LOCAL "slim + Purview DLP" demo: one script (agent_purview.py) that chats, uses
#  the WorkIQ Mail tool, exports Agent 365 observability, AND runs every prompt + response
#  through Microsoft Purview Data Loss Prevention policies (blocking sensitive content inline).
# ═══════════════════════════════════════════════════════════════════════════════
#
#  LEGEND — where each value comes from:
#    [FILL]   You provide it (Azure OpenAI / Foundry resource, or the Purview app id).
#    [CLI]    Generated by `a365 setup all`. Read from a365.generated.config.json.
#             The secret: run `a365 setup blueprint --show-secret` (same machine + user).
#    [SCRIPT] Written for you by a helper script — do not hand-edit.
#    [AUTO]   Sensible default already set below.
#
#  LEGEND — who reads each value (CONSUMED BY):
#    (LLM)   agent_purview.py → the Azure OpenAI client (auth is your `az login`, no key needed)
#    (OBS)   agent_purview.py → mints the observability token via the FMI 3-hop chain, then exports spans
#    (WORKIQ)agent_purview.py → the WorkIQ Mail MCP tool
#    (DLP)   agent_purview.py → the Microsoft Purview policy middleware (prompt + response DLP)
# ═══════════════════════════════════════════════════════════════════════════════


# ── LLM: Azure OpenAI (Foundry) ────────────────────────────────────────────────
# Auth is your Azure CLI session — run `az login` first; NO api key is used here.
# [FILL] (LLM)  Endpoint of your Foundry resource (ends with a slash).
AZURE_OPENAI_ENDPOINT=
# [FILL] (LLM)  The model DEPLOYMENT name you created in Foundry.
AZURE_OPENAI_DEPLOYMENT=gpt-5
# [FILL] (LLM)  API version. The Agent Framework OpenAI client uses the /openai/v1 surface → "preview".
AZURE_OPENAI_API_VERSION=preview


# ── Microsoft Purview DLP (prompt + response protection) ───────────────────────
# [FILL] (DLP)  Client id of the Entra app registration used to call the Purview / Microsoft
#               Graph data-security APIs. It needs these DELEGATED Graph permissions with admin
#               consent: ProtectionScopes.Compute.All, Content.Process.All, ContentActivity.Write.
#               On first policy check a browser opens for you to sign in (InteractiveBrowserCredential);
#               the signed-in user is who Purview evaluates policies for.
#               Leave EMPTY to run the agent without DLP.
PURVIEW_CLIENT_APP_ID=
# [AUTO] (DLP)  Display name Purview logs this app under (Audit / Activity Explorer).
PURVIEW_APP_NAME="a365-agent-purview"
# [FILL] (DLP)  Optional explicit user id (GUID). Usually NOT needed — with the interactive
#               user sign-in above, the user id is taken from the token automatically.
PURVIEW_DEFAULT_USER_ID=


# ── A365 identity — WHO the observability activities are attributed to ─────────
# You can reuse the a365-agent-slim blueprint here, or run `a365 setup all --agent-name
# a365-purview-demo --authmode s2s` to provision a dedicated one.
# [CLI] (OBS)  The agentic app id ("Entra agent id") — what spans are attributed to (NOT the blueprint id).
AGENT365_ACTIVITY_AGENT_ID=
# [FILL] (OBS)  Friendly name shown in the admin center Activity view.
AGENT365OBSERVABILITY__AGENTNAME="a365-purview-demo"
# [CLI] (OBS)  = a365.generated.config.json → agentBlueprintId (span metadata only).
AGENT365OBSERVABILITY__AGENTBLUEPRINTID=


# ── Blueprint credentials — used to MINT the observability token (FMI chain) ────
# [CLI] (OBS)  = agentBlueprintId
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
# [CLI] (OBS)  = `a365 setup blueprint --show-secret`
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
# [CLI] (OBS)  = your tenant id
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=


# ── WorkIQ Mail tool ───────────────────────────────────────────────────────────
# [SCRIPT] (WORKIQ)  A short-lived Mail token from `.\refresh-mail-token.ps1`. Leave empty to
#                    chat without mail tools. Expires ~1 hour — re-run the script to refresh.
BEARER_TOKEN=
