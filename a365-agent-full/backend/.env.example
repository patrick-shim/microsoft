# ─────────────────────────────────────────────────────────────────────────────
# a365-agent-full — environment template.  Copy to `.env` and fill in.
# Values marked "(a365 setup all)" are written automatically by the CLI into
# a365.generated.config.json — copy them here (or let deploy/set-appsettings.ps1
# push them to Container Apps).  NEVER commit the filled-in .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM: Azure OpenAI (required) ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-05-01-preview
# Leave AZURE_OPENAI_API_KEY empty to use Entra auth (Azure CLI locally / managed
# identity in Container Apps — needs the "Cognitive Services OpenAI User" role).
AZURE_OPENAI_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3978
LOG_LEVEL=INFO
# Production or Development. MUST be Production in the cloud, or the WorkIQ SDK runs
# in dev mode and skips the OBO token exchange even when USE_AGENTIC_AUTH=true.
PYTHON_ENVIRONMENT=Production

# ── Agentic auth handler (AI Teammate — the agent's own M365 identity) ────────
AUTH_HANDLER_NAME=AGENTIC
USE_AGENTIC_AUTH=true
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__TYPE=AgenticUserAuthorization
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__SCOPES=https://graph.microsoft.com/.default

# ── Bot Framework outbound auth (a365 setup all --aiteammate --m365) ──────────
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
CONNECTIONSMAP__0__SERVICEURL=*
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION

# ── A365 Observability ───────────────────────────────────────────────────────
# true in prod / dev tunnel (spans ship to A365); false locally (console only).
ENABLE_A365_OBSERVABILITY_EXPORTER=true
agent365Observability__agentId=
agent365Observability__tenantId=
agent365Observability__agentName="a365-full-demo"
agent365Observability__agentDescription="Microsoft 365 AI teammate demo"
# Blueprint id — used for MAC roll-up in InvokeAgent scopes (from a365.generated.config.json).
AGENT365_BLUEPRINT_ID=
# Hostname stamped onto observability spans (set to the Container App FQDN in prod).
AGENT_HOSTNAME=localhost
OTEL_LOG_LEVEL=INFO
A365_OBSERVABILITY_LOG_LEVEL=info|warn|error

# ── Local-only WorkIQ testing (a365 develop get-token) — empty in prod ────────
BEARER_TOKEN=
