# ═══════════════════════════════════════════════════════════════════════════════
#  a365-agent-full — environment template
#  Copy this file to `.env` and fill it in.  `.env` is gitignored — NEVER commit it.
# ═══════════════════════════════════════════════════════════════════════════════
#
#  LEGEND — where each value comes from:
#    [FILL]   You provide it (from your Azure OpenAI / Foundry resource or your choice).
#    [CLI]    Generated by `a365 setup all`. Read from a365.generated.config.json.
#             The secret: run `a365 setup blueprint --show-secret` (same machine + user).
#    [AUTO]   Sensible default already set below — change only if you know why.
#    [LOCAL]  Only for running on your laptop; leave EMPTY in the cloud.
#
#  LEGEND — who reads each value (CONSUMED BY):
#    (LLM)      agent.py → the Azure OpenAI / gpt-5 client
#    (HOST-IN)  host_agent_server.py → validates INBOUND Teams requests (JWT)
#    (HOST-OUT) host_agent_server.py → signs OUTBOUND replies back to Teams
#    (WORKIQ)   agent.py → the WorkIQ MCP tools (Mail/Teams/SharePoint/OneDrive)
#    (OBS)      host_agent_server.py → the A365 observability exporter
#    (RUNTIME)  the container / Python process itself
# ═══════════════════════════════════════════════════════════════════════════════


# ── LLM: Azure OpenAI (Foundry) ────────────────────────────────────────────────
# The agent's "brain". Get these from your Azure OpenAI / AI Foundry resource.
# [FILL] (LLM)  Endpoint of your Foundry resource (ends with a slash).
AZURE_OPENAI_ENDPOINT=
# [FILL] (LLM)  The model DEPLOYMENT name you created in Foundry (not the model family).
AZURE_OPENAI_DEPLOYMENT=gpt-5
# [FILL] (LLM)  API version. Match what your deployment supports.
AZURE_OPENAI_API_VERSION=preview
# [FILL] (LLM)  Foundry API key. LEAVE BLANK to use the container's managed identity instead
#               (then grant that identity the "Cognitive Services OpenAI User" role on the resource).
AZURE_OPENAI_API_KEY=


# ── Server / runtime ───────────────────────────────────────────────────────────
# [AUTO] (RUNTIME)  Port the aiohttp host listens on. Matches the Dockerfile EXPOSE + Container Apps target-port.
PORT=3978
# [AUTO] (RUNTIME)  Log level.
LOG_LEVEL=INFO
# [AUTO] (RUNTIME/WORKIQ)  MUST be "Production" in the cloud. If it's "Development" (or unset), the WorkIQ
#                          SDK runs in dev mode and SKIPS the agentic token exchange — tools silently break.
PYTHON_ENVIRONMENT=Production


# ── Agentic auth handler (the agent acts as ITS OWN identity) ──────────────────
# [AUTO] (WORKIQ/OBS)  Turns on the "Agentic User" token path used by tools + observability.
AUTH_HANDLER_NAME=AGENTIC
USE_AGENTIC_AUTH=true
# [AUTO] (WORKIQ/OBS)  Registers the agentic authorization handler and its scope.
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__TYPE=AgenticUserAuthorization
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__SCOPES=https://graph.microsoft.com/.default


# ── Blueprint credentials — OUTBOUND: signing replies to Teams ─────────────────
# These let the host mint an app-only token to POST replies back to the Teams service.
# [CLI] (HOST-OUT)  = a365.generated.config.json → agentBlueprintId
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
# [CLI] (HOST-OUT)  = `a365 setup blueprint --show-secret`
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
# [CLI] (HOST-OUT)  = your tenant id
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
# [AUTO] (HOST-OUT)  Route ALL outbound service URLs through the connection above. NOTE: DOUBLE underscores.
CONNECTIONSMAP__0__SERVICEURL=*
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION


# ── Blueprint credentials — INBOUND: validating Teams requests (JWT) ───────────
# SAME id/secret/tenant as above, but under the top-level names the host reads to VALIDATE incoming
# Teams JWTs. If these three are missing the host runs in ANONYMOUS mode (logs: "Auth: Anonymous")
# and Teams auth is effectively off. Set all three.
# [CLI] (HOST-IN)  = agentBlueprintId
CLIENT_ID=
# [CLI] (HOST-IN)  = your tenant id
TENANT_ID=
# [CLI] (HOST-IN)  = `a365 setup blueprint --show-secret`
CLIENT_SECRET=


# ── A365 Observability ─────────────────────────────────────────────────────────
# [AUTO] (OBS)  true in the cloud (ship spans to A365); set false locally for console-only traces.
ENABLE_A365_OBSERVABILITY_EXPORTER=true
# [CLI] (OBS)  = agentBlueprintId (the agent id spans are attributed to).
agent365Observability__agentId=
# [CLI] (OBS)  = your tenant id.
agent365Observability__tenantId=
# [FILL] (OBS)  Friendly name/description shown in the admin center (quotes kept).
agent365Observability__agentName="a365-full-demo"
agent365Observability__agentDescription="Microsoft 365 AI teammate demo"
# [CLI] (OBS)  = agentBlueprintId (used for roll-up).
AGENT365_BLUEPRINT_ID=


# ── Local-only WorkIQ testing ──────────────────────────────────────────────────
# [LOCAL] (WORKIQ)  A dev token from `a365 develop get-token`. Leave EMPTY in the cloud (the agent
#                   uses the agentic token exchange there instead).
BEARER_TOKEN=
